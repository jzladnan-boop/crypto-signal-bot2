FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN npm install -g pnpm && pnpm install --frozen-lockfile

# Copy app code
COPY . .

# Build for web
RUN pnpm run build

# Expose port
EXPOSE 3000

# Start web server
CMD ["pnpm", "run", "start"]
